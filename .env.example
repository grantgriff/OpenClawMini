# ═══════════════════════════════════════════════════════════════════
# MODEL PROVIDERS (Only need keys for providers you're using)
# ═══════════════════════════════════════════════════════════════════

# Anthropic (Claude) - for orchestrator
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini) - for research, data gen, judges
GOOGLE_API_KEY=AIza...

# OpenAI (GPT) - optional, if using OpenAI models
OPENAI_API_KEY=sk-...

# Mistral - REQUIRED (base model for fine-tuning)
MISTRAL_API_KEY=...

# ═══════════════════════════════════════════════════════════════════
# W&B (REQUIRED for training + MCP + logging)
# ═══════════════════════════════════════════════════════════════════
WANDB_API_KEY=...
WANDB_ENTITY=your_username
WANDB_PROJECT=openclawmini

# ═══════════════════════════════════════════════════════════════════
# DATA SOURCES - APIs (READ-ONLY ACCESS)
# ═══════════════════════════════════════════════════════════════════

# Gmail OAuth (READ-ONLY - we only read sent emails)
# Scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:8080/callback
GMAIL_TOKEN_PATH=./data/gmail_token.json

# LinkedIn API (READ-ONLY - profile and posts only)
# Scopes: r_liteprofile, r_emailaddress, r_member_social
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...

# ═══════════════════════════════════════════════════════════════════
# STORAGE (Memory persistence)
# ═══════════════════════════════════════════════════════════════════
MEMORY_STORAGE_TYPE=file
MEMORY_FILE_PATH=./data/memory.json

# ═══════════════════════════════════════════════════════════════════
# TRAINING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
SFT_SAMPLE_COUNT=200
GRPO_SCENARIO_COUNT=100
QUALITY_THRESHOLD=7.0
SFT_FACTUAL_THRESHOLD=0.70
FINAL_TARGET_ACCURACY=0.80
SFT_EPOCHS=3
SFT_LEARNING_RATE=2e-5
GRPO_STEPS=100
GRPO_TRAJECTORIES_PER_SCENARIO=4
